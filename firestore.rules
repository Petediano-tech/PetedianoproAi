/**
 * @fileoverview Firestore Security Rules for Petediano Pro.
 *
 * Core Philosophy:
 * This ruleset enforces a user-ownership model for user-specific data and allows public read access to shared gallery content.
 *
 * Data Structure:
 * - User account data is stored under `/users/{userId}`.
 * - Gallery items are stored in the top-level `/galleryItems/{itemId}` collection.
 *
 * Key Security Decisions:
 * - Users can only read and write their own data under `/users/{userId}`.
 * - Gallery items are publicly readable.
 * - Gallery item creation requires a valid user ID matching the `author` field.
 * - Gallery item updates are limited to incrementing the `likes` field and can be performed by anyone.
 * - Listing of user documents is denied as a general security measure.
 *
 * Denormalization for Authorization:
 * - The `GalleryItem` includes an `author` field, which is the user's display name.
 *   This is for display purposes only. Authorization is based on the user ID.
 *
 * Structural Segregation:
 * - Public `GalleryItem` data is separated from private user data to simplify read access.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user ID matches the provided user ID.
     * @param {string} userId The user ID to compare against.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is the owner of an existing document.
     * @param {string} userId The user ID to compare against.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }


    match /users/{userId} {
      /**
       * @description Allows users to read and write their own user document.
       * @path /users/{userId}
       * @allow (create) User with UID 'sB28DTIp98XiVbk3XVmFBPHJqPs1' can create their own user document.
       * @deny (create) User with UID 'otherUserId' cannot create a document under /users/sB28DTIp98XiVbk3XVmFBPHJqPs1.
       * @allow (get) User with UID 'sB28DTIp98XiVbk3XVmFBPHJqPs1' can get their own user document.
       * @deny (get) User with UID 'otherUserId' cannot get the document under /users/sB28DTIp98XiVbk3XVmFBPHJqPs1.
       * @allow (update) User with UID 'sB28DTIp98XiVbk3XVmFBPHJqPs1' can update their own user document.
       * @deny (update) User with UID 'otherUserId' cannot update the document under /users/sB28DTIp98XiVbk3XVmFBPHJqPs1.
       * @allow (delete) User with UID 'sB28DTIp98XiVbk3XVmFBPHJqPs1' can delete their own user document.
       * @deny (delete) User with UID 'otherUserId' cannot delete the document under /users/sB28DTIp98XiVbk3XVmFBPHJqPs1.
       * @deny (list) No one can list user documents.
       * @principle Enforces document ownership for reads and writes.
       */
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.uid == resource.data.uid;
      allow delete: if isExistingOwner(userId);
    }

    match /galleryItems/{itemId} {
      /**
       * @description Allows anyone to read gallery items, but restricts creation and updates.
       * @path /galleryItems/{itemId}
       * @allow (get) Any user can read any gallery item.
       * @allow (list) Any user can list gallery items.
       * @allow (create) User with UID 'user123' can create a gallery item with authorId 'user123'.
       * @deny (create) User with UID 'user123' cannot create a gallery item with authorId 'user456'.
       * @allow (update) Any user can update the likes count of a gallery item.
       * @deny (update) User with UID 'user123' cannot modify other fields of a gallery item.
       * @deny (delete) No one can delete a gallery item.
       * @principle Allows public read access with owner-only writes and restricted updates.
       */
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if true;
      allow delete: if false;
    }
  }
}